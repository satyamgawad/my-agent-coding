# The free default: install Ollama, then run `ollama pull qwen2.5-coder:7b`.
# Ollama's local API needs no real key. Keep these defaults unless you choose
# another installed local model.
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen2.5-coder:7b
# OLLAMA_API_KEY=only-needed-for-a-secured-remote-ollama-endpoint

# Optional automatic NVIDIA route. When this key is set, the agent uses
# Nemotron 3 Ultra and falls back to local Qwen on a transient NVIDIA failure.
# NVIDIA_API_KEY=your_nvidia_api_key
# NVIDIA_NEMOTRON_ULTRA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# NVIDIA_NEMOTRON_ULTRA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional NVIDIA Safety Guard. Enable it from the dashboard toggle when you
# want remote input/output moderation. It fails open to local safeguards if
# NVIDIA is unavailable or rate-limited.
# NVIDIA_SAFETY_MODEL=nvidia/nemotron-3.5-content-safety
# NVIDIA_SAFETY_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional agent work budget, from 10 to 100 tool/model steps. Default: 30.
# AGENT_MAX_STEPS=60

# Optional wall-clock task deadline in milliseconds, from 30,000 to 3,600,000.
# The default is 900,000 (15 minutes). A timed-out task keeps completed changes.
# AGENT_TASK_TIMEOUT_MS=900000

# Optional project-code execution boundary. The default host mode keeps the
# normal local workflow. Docker mode runs test/build/node checks in a temporary,
# network-disabled, capability-dropped Node container with only the active
# project mounted. Docker Desktop and the image must be available first.
# AGENT_EXECUTION_MODE=docker
# AGENT_SANDBOX_IMAGE=node:22-alpine

# Local UI default: http://127.0.0.1:3333
# AGENT_UI_PORT=3333

# Docker/private hosting only. Keep this in your host's secret manager, never Git.
# It must be at least 16 characters long.
# AGENT_UI_PASSWORD=replace-with-a-unique-password

# Optional GitHub source publishing. Use a fine-grained token limited to the
# configured repository with Contents read/write permission. Never commit it.
# GITHUB_TOKEN=github_pat_...
# GITHUB_REPOSITORY=your-account/your-repository
# GITHUB_BRANCH=main

# The Dockerfile sets these automatically; do not enable them for normal local use.
# AGENT_UI_HOST=0.0.0.0
# PORT=3000
