# The free default: install Ollama, then run `ollama pull qwen2.5-coder:7b`.
# Ollama's local API needs no real key. Keep these defaults unless you choose
# another installed local model.
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen2.5-coder:7b
# OLLAMA_GEMMA_MODEL=gemma4:e2b

# Optional route: auto (default), local, gemma, build, smart, power, or custom.
# AGENT_MODEL_MODE=auto

# Optional NVIDIA Power Build route for Muse Glimmer 30B. Copy the exact model
# ID from your NVIDIA API Catalog page; it is deliberately not guessed here.
# NVIDIA_API_KEY=your_nvidia_api_key
# NVIDIA_MUSE_MODEL=the-exact-nvidia-catalog-model-id
# NVIDIA_MUSE_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional remote OpenAI-compatible model. It is never used unless you choose
# Remote in the dashboard or set AGENT_MODEL_MODE=custom. The local Ollama model
# remains the fallback when the remote provider is unavailable.
# AGENT_MODEL_BASE_URL=https://your-provider.example/v1
# AGENT_MODEL_API_KEY=your_provider_key
# AGENT_MODEL=provider/model-id
# FINETUNE_MODEL=your-workspace/your-finetuned-model

# Optional agent work budget, from 10 to 100 tool/model steps. Default: 30.
# AGENT_MAX_STEPS=60

# Local UI default: http://127.0.0.1:3333
# AGENT_UI_PORT=3333

# Docker/private hosting only. Keep this in your host's secret manager, never Git.
# It must be at least 16 characters long.
# AGENT_UI_PASSWORD=replace-with-a-unique-password

# Optional GitHub source publishing. Use a fine-grained token limited to the
# configured repository with Contents read/write permission. Never commit it.
# GITHUB_TOKEN=github_pat_...
# GITHUB_REPOSITORY=your-account/your-repository
# GITHUB_BRANCH=main

# The Dockerfile sets these automatically; do not enable them for normal local use.
# AGENT_UI_HOST=0.0.0.0
# PORT=3000
