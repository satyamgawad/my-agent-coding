# Required for the coding agent.
NVIDIA_API_KEY=your_nvidia_api_key_here

# Optional model routing: auto (default), smart, nano, oss, llama, kimi,
# oss120, ultra, or glm. Older flash settings safely use nano.
# NVIDIA_MODEL_MODE=auto

# Optional override for a model outside the built-in seven-model route.
# NVIDIA_MODEL=provider/model-id

# Optional OpenAI-compatible endpoint, such as a private NVIDIA NIM deployment
# serving a fine-tuned model. Keep the endpoint key private. NVIDIA's hosted
# endpoint remains the default when these settings are omitted.
# AGENT_MODEL_BASE_URL=https://your-nim-host.example/v1
# AGENT_MODEL_API_KEY=your_nim_api_key
# NVIDIA_MODEL=your-workspace/your-finetuned-model
# FINETUNE_MODEL=your-workspace/your-finetuned-model
# In the dashboard, choose Fine-tuned for the custom model alone, or Smart to
# use that configured model with planning and an independent review pass.

# Optional agent work budget, from 10 to 100 tool/model steps. Default: 30.
# AGENT_MAX_STEPS=60

# Local UI default: http://127.0.0.1:3333
# AGENT_UI_PORT=3333

# Docker/private hosting only. Keep this in your host's secret manager, never Git.
# It must be at least 16 characters long.
# AGENT_UI_PASSWORD=replace-with-a-unique-password

# Optional GitHub source publishing. Use a fine-grained token limited to the
# configured repository with Contents read/write permission. Never commit it.
# GITHUB_TOKEN=github_pat_...
# GITHUB_REPOSITORY=your-account/your-repository
# GITHUB_BRANCH=main

# The Dockerfile sets these automatically; do not enable them for normal local use.
# AGENT_UI_HOST=0.0.0.0
# PORT=3000
